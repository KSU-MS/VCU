  COMMAND = cd /home/klee/Github/VCU/build/src && /home/klee/tools/arm-gnu-toolchain-14.3.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-size firmware.elf && /home/klee/tools/arm-gnu-toolchain-14.3.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-objcopy -O ihex -R .eeprom firmware.elf firmware.hex
  DESC = Creating HEX file for firmware.elf
  restat = 1

